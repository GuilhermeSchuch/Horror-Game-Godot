[sub_resource type="GDScript" id="GDScript_fjrip"]
script/source = "extends Node3D

@export var shake_duration := 0.8
@export var shake_strength := 0.25
@export var return_speed := 8.0

var shaking := false
var shake_timer := 0.0

var shake_offset_pos := Vector3.ZERO
var shake_offset_rot := Vector3.ZERO

func _process(delta):
	if shaking:
		shake_timer -= delta

		# Generate violent shake offsets
		shake_offset_rot = Vector3(
			randf_range(-shake_strength, shake_strength),
			randf_range(-shake_strength, shake_strength),
			randf_range(-shake_strength, shake_strength)
		)

		shake_offset_pos = Vector3(
			randf_range(-shake_strength * 0.2, shake_strength * 0.2),
			randf_range(-shake_strength * 0.2, shake_strength * 0.2),
			randf_range(-shake_strength * 0.2, shake_strength * 0.2)
		)

		if shake_timer <= 0:
			shaking = false

	else:
		# Smoothly blend shake back to zero (DON'T touch player's camera)
		shake_offset_pos = shake_offset_pos.lerp(Vector3.ZERO, return_speed * delta)
		shake_offset_rot = shake_offset_rot.lerp(Vector3.ZERO, return_speed * delta)

	# Apply shake ADDITIVELY
	position += shake_offset_pos
	rotation += shake_offset_rot

func start_jumpscare_shake():
	shaking = true
	shake_timer = shake_duration
"

